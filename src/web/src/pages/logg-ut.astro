---
import { logout } from '@saman/shared'

// A form post, so a link or an image elsewhere can't log people out.
if (Astro.request.method !== 'POST') return Astro.redirect('/')

const headers = new Headers({ Location: '/logg-inn' })
for (const cookie of await logout(Astro.request.headers.get('cookie'))) {
  headers.append('Set-Cookie', cookie)
}
return new Response(null, { status: 303, headers })
---
