---
import { cmsFetch } from '@saman/shared'

const cmsURL = import.meta.env.PUBLIC_CMS_URL

let status: string
try {
  await cmsFetch<{ status: string }>('/health')
  status = 'Connected — the CMS reached its database.'
} catch (err) {
  status = `Not reachable: ${err instanceof Error ? err.message : String(err)}`
}
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Saman — utviklingsmiljø</title>
  </head>
  <body>
    <h1>Saman</h1>
    <p>Astro frontend. Scaffold only — no application code yet.</p>
    <h2>Payload CMS</h2>
    <p>{cmsURL}</p>
    <p>{status}</p>
    <p><a href={`${cmsURL}/admin`}>Open the admin panel</a></p>
  </body>
</html>
